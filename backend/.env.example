PORT=5000
NODE_ENV=development

# CORS: comma-separated list of allowed origins
# e.g. http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas SRV connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_micro_crm_dev?retryWrites=true&w=majority

# Authentication Secrets (use long, random values in production)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Notification Provider ("mock" | "whatsapp")
NOTIFICATION_PROVIDER=mock
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=

# AI Configuration (Optional)
AI_ENABLED=false
GEMINI_API_KEY=
